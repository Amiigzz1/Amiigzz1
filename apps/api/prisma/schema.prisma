// Majlis — Prisma schema
// All personally identifiable identifiers are hashed. `phone_hash` is the
// primary lookup field; the raw phone number is never persisted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Users ----------

enum Country {
  SA
  AE
  EG
  KW
  OM
  BH
  QA
  JO
}

enum Language {
  ar
  en
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  // HMAC-SHA256(phone_e164) — stable, non-reversible, safe to log.
  phoneHash    String    @unique @map("phone_hash")
  // Encrypted E.164 phone for support lookups. NULL until we wire KMS.
  phoneCipher  String?   @map("phone_cipher")
  displayName  String?   @map("display_name") @db.VarChar(48)
  avatarUrl    String?   @map("avatar_url")
  country      Country?
  language     Language  @default(ar)
  birthdate    DateTime? @db.Date
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  bannedAt     DateTime? @map("banned_at")
  banReason    String?   @map("ban_reason")

  profile       UserProfile?
  refreshTokens RefreshToken[]
  rooms         Room[]         @relation("RoomOwner")
  wallet        Wallet?
  transactions  Transaction[]

  @@index([createdAt])
  @@map("users")
}

model UserProfile {
  userId        String   @id @map("user_id") @db.Uuid
  bio           String?  @db.VarChar(240)
  favoriteGames String[] @default([]) @map("favorite_games")
  badges        String[] @default([])
  frameId       String?  @map("frame_id")
  nameplateId   String?  @map("nameplate_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// ---------- Rooms ----------

enum RoomCategory {
  gaming
  music
  chat
  story
}

model Room {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @db.VarChar(64)
  description   String?       @db.VarChar(240)
  ownerId       String        @map("owner_id") @db.Uuid
  category      RoomCategory
  country       Country?
  maxSeats      Int           @default(8) @map("max_seats")
  locked        Boolean       @default(false)
  // Agora channel id. Unique so two rooms never collide on the voice layer.
  agoraChannel  String        @unique @map("agora_channel")
  // Live participant + speaker counts, maintained by the Go realtime service.
  // Persisted here so Discover can rank rooms without a round-trip to Redis.
  listenersLive Int           @default(0) @map("listeners_live")
  speakersLive  Int           @default(0) @map("speakers_live")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  closedAt      DateTime?     @map("closed_at")

  owner User @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([closedAt, category, country, createdAt])
  @@map("rooms")
}

// ---------- Auth ----------

// Refresh tokens live in Redis for the hot path (rotation, revocation), but
// we mirror them to Postgres so security audits, per-user device lists, and
// "log out everywhere" survive a Redis flush.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  // SHA-256 of the opaque refresh token string.
  tokenHash  String    @unique @map("token_hash")
  deviceId   String?   @map("device_id")
  userAgent  String?   @map("user_agent") @db.VarChar(256)
  ipHash     String?   @map("ip_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  // When a token is rotated, we point to the successor for forensic chains.
  rotatedTo  String?   @map("rotated_to") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------- Economy ----------

enum TxType {
  purchase
  game_stake
  game_payout
  gift_sent
  gift_received
  withdrawal
  admin_adjust
}

enum GameKind {
  ludo
}

model Wallet {
  userId    String   @id @map("user_id") @db.Uuid
  coins     BigInt   @default(0)
  diamonds  BigInt   @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Transaction {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  type         TxType
  coinsDelta   BigInt   @default(0) @map("coins_delta")
  diamondDelta BigInt   @default(0) @map("diamond_delta")
  /// Idempotency key scoped by (user, type, refId).
  refId        String   @map("ref_id")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, refId])
  @@index([userId, createdAt])
  @@map("transactions")
}

model GameRound {
  id           String    @id @default(uuid()) @db.Uuid
  kind         GameKind
  stakeCoins   BigInt    @map("stake_coins")
  winnerId     String?   @map("winner_id") @db.Uuid
  participants String[]  @default([]) @db.Uuid
  startedAt    DateTime  @default(now()) @map("started_at")
  endedAt      DateTime? @map("ended_at")
  metadata     Json?

  @@index([startedAt])
  @@map("game_rounds")
}
