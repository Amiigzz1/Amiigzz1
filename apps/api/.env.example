############################################################
# Majlis API — local development environment
# Copy to `.env` and adjust if needed. No cloud accounts are
# required to run the stack locally.
############################################################

NODE_ENV=development
PORT=3000

# --- Data stores (docker-compose) ---
DATABASE_URL=postgres://majlis:majlis_dev@localhost:5432/majlis
REDIS_URL=redis://localhost:6379
REALTIME_URL=http://localhost:8080

# Shared secret for NestJS → realtime internal HTTP calls. Any long random
# string; must match REALTIME_INTERNAL_TOKEN on the realtime service.
REALTIME_INTERNAL_TOKEN=dev_only_realtime_internal_token

# --- Auth ---
# Dev secret only. CI and prod use a long random value from Secrets Manager.
JWT_SECRET=dev_only_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Local-first mock modes ---
# When true, /auth/request-otp prints the OTP to the API logs instead of
# contacting Firebase. /auth/verify-otp accepts any OTP stored in Redis
# for the given phone number (dev convenience).
LOCAL_OTP_MODE=true

# mock | agora
# mock: /rooms/:id returns a fake Agora token so the Flutter client can
# exercise UI flows without real voice transport.
AGORA_MODE=mock
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# mock | live
# mock: /payments/webhooks/* can be triggered via the admin dashboard to
# simulate successful purchases without hitting real providers.
PAYMENTS_MODE=mock
TAP_SECRET_KEY=
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=

# local | openai
# local: moderation pipeline uses only @majlis/arabic-nlp (offline). Nothing
# leaves your machine. Useful for offline hack days.
MODERATION_MODE=local
OPENAI_API_KEY=

# --- Object storage (MinIO locally, S3 in prod) ---
# Inside docker, the API connects via http://minio:9000.
# From the host (including Flutter), public URLs must use http://localhost:9000.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_UPLOADS=majlis-uploads
S3_BUCKET_VOICE_CLIPS=majlis-voice-clips
S3_FORCE_PATH_STYLE=true

# --- Mail (Mailhog locally, real SMTP in prod) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Majlis <no-reply@majlis.local>"

# --- Observability (all disabled by default for local) ---
SENTRY_DSN=
LOG_LEVEL=debug
